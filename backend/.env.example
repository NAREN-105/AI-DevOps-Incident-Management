DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/incident_db
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Google Identity Services client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# SMTP settings (use a provider-issued app password, not your mailbox password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com
SMTP_USE_TLS=true

# Comma-separated recipients for organization-wide incident alerts.
INCIDENT_MANAGER_EMAILS=